{
  "name": "skeleton-database",
  "version": "1.0.0",
  "private": true,
  "description": "Open SaaS Skeleton — Spreadsheet/Database Tool",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down",
    "migrate": "npm run migrate -w server",
    "seed": "npm run seed -w server",
    "test": "npm run test -w server"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}

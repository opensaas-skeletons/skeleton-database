# ---- Database ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skeleton_database
DB_USER=postgres
DB_PASSWORD=postgres

# ---- Server ----
PORT=3003
# CORS: Use "*" for development. Restrict to specific origins in production.
CORS_ORIGIN=*
NODE_ENV=development

# ---- Seed ----
SEED_ON_START=true

# ---- Auth ----
# Set AUTH_ENABLED=true to require authentication on API routes.
# Supports both API key (x-api-key header) and JWT Bearer token auth.
# AUTH_ENABLED=true
# API_KEY=your-api-key-here
# JWT_SECRET=your-jwt-secret-key-here
